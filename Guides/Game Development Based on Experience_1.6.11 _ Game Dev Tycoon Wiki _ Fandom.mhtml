pencil-tiny"></use></svg></a><span class=3D"mw-editsection-bracket">]</span=
></span></h4>
<figure class=3D"thumb  show-info-icon" typeof=3D"mw:File/Thumb" style=3D"w=
idth: 180px"> 	<a href=3D"https://static.wikia.nocookie.net/gamedevtycoon/i=
mages/4/40/MMO.jpg/revision/latest?cb=3D20130501131828" class=3D"mw-file-de=
