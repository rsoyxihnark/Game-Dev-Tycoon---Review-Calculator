</td>
<td>2.5
</td>
<td>2.33
</td>
<td>2.9%
</td></tr>
<tr>
<td>Casual
</td>
<td>Design
</td>
<td>2.0
</td>
<td>1.73
</td>
<td>7.9%
</td></tr>
<tr>
<td>Simulation
</td>
<td>Tech
</td>
<td>1.6
</td>
<td>1.46
</td>
<td>9.6%
</td></tr>
<tr>
<td>Strategy
</td>
