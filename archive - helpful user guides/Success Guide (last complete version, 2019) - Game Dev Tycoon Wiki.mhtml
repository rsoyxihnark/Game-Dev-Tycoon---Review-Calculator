</th>
<th colspan=3D"2" rowspan=3D"1" scope=3D"col" style=3D"text-align: center;"=
>Field 3
</th></tr>
<tr>
<th style=3D"text-align: center; width: 80px;">Design&nbsp;%
</th>
<th style=3D"text-align: center; width: 80px;">&nbsp;Tech&nbsp;%&nbsp;
</th>
